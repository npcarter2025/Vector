{
  "name": "vector-extension",
  "displayName": "Vector Extension",
  "description": "A VS Code extension created in the Vector directory",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:vector.helloWorld",
    "onCommand:vector.refreshPanel",
    "onView:vectorPanelView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vector.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "vector.refreshPanel",
        "title": "Vector: Refresh Panel"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vectorPanel",
          "title": "Vector",
          "icon": "resources/vector.svg"
        }
      ]
    },
    "views": {
      "vectorPanel": [
        {
          "id": "vectorPanelView",
          "name": "Vector Panel"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4"
  }
}

