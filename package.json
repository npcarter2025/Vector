{
  "name": "vector-extension",
  "displayName": "Vector Extension",
  "description": "A VS Code extension created in the Vector directory",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:vector.helloWorld",
    "onCommand:vector.refreshPanel",
    "onCommand:vector.sendMessage",
      "onCommand:vector.clearConversation",
      "onCommand:vector.showMessage",
      "onCommand:vector.testIndexing",
      "onView:vectorPanelView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vector.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "vector.refreshPanel",
        "title": "Vector: Refresh Panel"
      },
      {
        "command": "vector.sendMessage",
        "title": "Vector: Send Prompt"
      },
      {
        "command": "vector.clearConversation",
        "title": "Vector: Clear Conversation"
      },
      {
        "command": "vector.showMessage",
        "title": "Vector: Show Message"
      },
      {
        "command": "vector.testIndexing",
        "title": "Vector: Test Indexing Infrastructure"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vectorPanel",
          "title": "Vector",
          "icon": "resources/vector.svg"
        }
      ]
    },
    "views": {
      "vectorPanel": [
        {
          "type": "webview",
          "id": "vectorPanelView",
          "name": "Vector Panel"
        }
      ]
    },
    "configuration": {
      "title": "Vector Extension",
      "properties": {
        "vector.ollama.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL for the local Ollama server."
        },
        "vector.ollama.model": {
          "type": "string",
          "default": "gemma3:1b",
          "description": "Default Ollama model used for chat responses."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build-webview",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build-webview": "node scripts/build-webview.js",
    "build-webview:watch": "node scripts/build-webview.js --watch"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "esbuild": "^0.19.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "node-fetch": "^3.3.2",
    "sqlite3": "^5.1.7",
    "sqlite": "^5.1.1",
    "p-limit": "^6.1.0",
    "web-tree-sitter": "^0.21.0",
    "tree-sitter-wasms": "^0.1.11",
    "vectordb": "^0.4.20",
    "uuid": "^9.0.1"
  }
}

